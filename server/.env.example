# Copy this file to server/.env and fill in real values. Never commit .env.

# development | test | production
NODE_ENV=development
# Port the API listens on
PORT=3000
# The React app's address: the only origin CORS allows to call the API
CLIENT_URL=http://localhost:5173

# Secrets that sign login tokens: at least 32 random characters each, different from each other.
# Generate one with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# How long tokens last
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# MongoDB connection string (used from Video 59). Include the database name, campushub.
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/campushub?retryWrites=true&w=majority
# Local:  mongodb://localhost:27017/campushub
MONGODB_URI=

# Where uploaded posters go: local (folder on disk) or object (see src/services/storage/objectStorage.js)
STORAGE_DRIVER=local
# Folder for local uploads, relative to server/
UPLOAD_DIR=uploads

# Email for event reminders. Leave SMTP_HOST empty in development: reminders are built but not sent.
# For a free test inbox, create an account at https://ethereal.email and paste its SMTP details here.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=CampusHub <no-reply@campushub.dev>
