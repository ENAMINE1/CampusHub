# Copy this file to server/.env and fill in real values. Never commit .env.

# development | test | production
NODE_ENV=development
# Port the API listens on
PORT=3000
# The React app's address: the only origin CORS allows to call the API
CLIENT_URL=http://localhost:5173

# Used from later videos (leave blank until then)
# MongoDB connection string (Video 59)
MONGODB_URI=
# Secrets that sign login tokens (Video 56). Use long random strings, different for each.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
