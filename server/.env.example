# Copy this file to server/.env and fill in real values. Never commit .env.

# development | test | production
NODE_ENV=development
# Port the API listens on
PORT=3000
# The React app's address: the only origin CORS allows to call the API
CLIENT_URL=http://localhost:5173

# Secrets that sign login tokens: at least 32 random characters each, different from each other.
# Generate one with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# How long tokens last
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# MongoDB connection string (used from Video 59). Include the database name, campushub.
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/campushub?retryWrites=true&w=majority
# Local:  mongodb://localhost:27017/campushub
MONGODB_URI=
