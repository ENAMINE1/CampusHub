# Copy this file to server/.env and fill in real values. Never commit .env.

# development | test | production
NODE_ENV=development
# Port the API listens on
PORT=3000
# The React app's address: the only origin CORS allows to call the API
CLIENT_URL=http://localhost:5173

# Secrets that sign login tokens: at least 32 random characters each, different from each other.
# Generate one with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# How long tokens last
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Used from later videos (leave blank until then)
# MongoDB connection string (Video 59)
MONGODB_URI=
