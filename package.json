{
  "name": "campushub",
  "private": true,
  "description": "CampusHub: the reference MERN app for the course",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspace client",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "npm test --workspaces --if-present",
    "build": "npm run build --workspace client"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.10"
  }
}
