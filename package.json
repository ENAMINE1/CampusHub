{
  "name": "campushub",
  "private": true,
  "description": "CampusHub: the reference MERN app for the course",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently --names client,server --prefix-colors blue,green \"npm run dev --workspace client\" \"npm run dev --workspace server\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "npm test --workspaces --if-present",
    "build": "npm run build --workspace client",
    "seed": "npm run seed --workspace server",
    "e2e": "playwright test --config e2e/playwright.config.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "concurrently": "10.0.6",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.10"
  },
  "allowScripts": {
    "bcrypt": false,
    "mongodb-memory-server": false
  }
}
