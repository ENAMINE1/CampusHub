# Copy to client/.env if you need to override defaults. Never put secrets here:
# every VITE_ variable is bundled into the JavaScript that browsers download.

# Where the API lives. Leave unset in development to use the Vite proxy (/api/v1).
# In production, e.g. https://campushub-api.onrender.com/api/v1
VITE_API_URL=

# Where Socket.IO connects for live seats. Leave unset in development (same origin, Vite proxy).
# In production, the API origin, e.g. https://campushub-api.onrender.com
VITE_SOCKET_URL=
